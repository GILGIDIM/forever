{
  "name": "forever-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node scripts/dev-api.js\" \"vite\"",
    "dev:web": "vite",
    "dev:api": "node scripts/dev-api.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test shared/*.test.js"
  },
  "dependencies": {
    "jose": "^6.2.0",
    "postgres": "^3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "dotenv": "^17.2.0",
    "vite": "^7.1.0"
  },
  "engines": { "node": ">=20" }
}
