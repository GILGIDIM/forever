# Copy to .env for local development. On Vercel, set these in Project Settings -> Environment Variables.

# Postgres. On Vercel, adding the Neon integration sets this for you (use the pooled URL).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/forever

# Same Battle.net app credentials style as the Midnight tracker.
# Add <PUBLIC_URL>/api/auth/callback as a redirect URL on the app at develop.battle.net.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# Where the site lives. Used for the OAuth redirect.
PUBLIC_URL=http://localhost:5173

# Any long random string (openssl rand -hex 32).
SESSION_SECRET=

# Blizzard profile API namespace prefix for WoW Forever. Unknown until launch;
# leave blank and the site runs on manual entry. Region suffix is added for you.
BLIZZARD_PROFILE_NAMESPACE=

# Local development helpers. Never set these on Vercel.
ALLOW_DEV_LOGIN=1
BLIZZARD_MOCK=1
